# Production Environment Configuration
# Copy this file to .env.production and fill in your production values
# Vite automatically loads .env.production when building for production

# API Base URL
# For production, use relative path if frontend is served from same origin as backend
# Or use absolute URL if frontend is on a different domain
VITE_API_URL=/api
# Alternative: VITE_API_URL=https://your-backend-domain.com/api

# Optional: Add other frontend-specific environment variables here
# VITE_APP_NAME=Mosaic
# VITE_APP_VERSION=1.0.0

# PostHog analytics
VITE_POSTHOG_KEY=phc_your_project_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_ENV=production
