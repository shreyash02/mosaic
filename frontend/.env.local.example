# Local Development Environment Configuration
# Copy this file to .env.local and fill in your values
# Vite automatically loads .env.local in development mode

# API Base URL
# For local development, point to your local backend
VITE_API_URL=http://localhost:8000/api

# Optional: Add other frontend-specific environment variables here
# VITE_APP_NAME=Mosaic
# VITE_APP_VERSION=1.0.0

# PostHog analytics (optional — all analytics no-op when key is absent)
# VITE_POSTHOG_KEY=phc_your_project_key
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_POSTHOG_ENV=development
