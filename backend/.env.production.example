# Production Environment Configuration
# Copy this file to .env.production and fill in your production values
# Set ENVIRONMENT=production when running in production

# App Configuration
APP_NAME=Mosaic
DEBUG=false
ENVIRONMENT=production

# Database
# Use your production database URL (e.g., from Fly.io, AWS RDS, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database

# Security
# IMPORTANT: Use a strong, randomly generated secret key in production
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-production-secret-key-change-this

# Google OAuth
# Update these with your production OAuth credentials
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
# Base URL for your production deployment (e.g., https://mosaic-autumn-snow-9557.fly.dev)
BASE_URL=https://your-production-domain.com
# GOOGLE_REDIRECT_URI is optional, will be constructed from BASE_URL if not set

# CORS Origins (comma-separated)
# Update with your production frontend URL(s)
CORS_ORIGINS=https://your-production-domain.com

# OpenAI API (for embeddings)
OPENAI_API_KEY=sk-your-production-openai-api-key

# Anthropic API (for LLM analysis)
ANTHROPIC_API_KEY=sk-ant-your-production-anthropic-api-key

# Analysis Configuration (optional, defaults shown)
# DBSCAN_EPS=0.35
# DBSCAN_MIN_SAMPLES=2
# MIN_RESPONSES_FOR_CLUSTERING=3
# MAX_RESPONSE_LENGTH=10000
