# Local Development Environment Configuration
# Copy this file to .env.local and fill in your values

# App Configuration
APP_NAME=Mosaic
DEBUG=true
ENVIRONMENT=local

# Database
# For local development with Docker Compose:
DATABASE_URL=postgresql://mosaic:mosaic@localhost:5432/mosaic
# For local development without Docker:
# DATABASE_URL=postgresql://user:password@localhost:5432/mosaic

# Security
# Generate a secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Google OAuth
GOOGLE_CLIENT_ID=1066293925506-r0e8mcicmr10puu758d8i1d5hbtnu845.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
BASE_URL=http://localhost:8000
# GOOGLE_REDIRECT_URI is optional, will be constructed from BASE_URL if not set

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# OpenAI API (for embeddings)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API (for LLM analysis)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Analysis Configuration (optional, defaults shown)
# DBSCAN_EPS=0.35
# DBSCAN_MIN_SAMPLES=2
# MIN_RESPONSES_FOR_CLUSTERING=3
# MAX_RESPONSE_LENGTH=10000
